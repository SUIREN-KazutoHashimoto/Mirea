# Direct execution: bind address/port. Compose: published host address/port;
# inside the container these remain 0.0.0.0:3000.
HOST=127.0.0.1
PORT=3000
# Optional direct HTTPS. Both PEM paths are required; relative to installation.
# HTTPS_KEY_FILE=./certificates/server-key.pem
# HTTPS_CERT_FILE=./certificates/server-chain.pem
# Direct execution: relative paths are resolved from the installation directory.
# Compose uses its named volume by default. compose.host-data.yaml opts into this
# existing host directory (Windows example: C:/MireaData).
DATA_DIR=./data
# Optional: existing, separately mounted directory for uploads/videos/originals.
# Leave unset for the legacy single-root layout. Existing installations must
# stop, back up and run scripts/prepare-media-storage.mjs before enabling it.
# MEDIA_DIR=/mnt/mirea-media
# Comma-separated trusted origins. Android Capacitor uses https://localhost.
CORS_ORIGINS=https://localhost
MAX_UPLOAD_BYTES=2147483648
# Transfer slots do not include server post-processing. Admin UI can override.
MAX_CONCURRENT_UPLOADS=3
MAX_CONCURRENT_JOBS=5
MAX_CONCURRENT_THUMBNAILS=2
MAX_CONCURRENT_PREVIEWS=1
MAX_CONCURRENT_INGEST=2
MAX_UPLOAD_ASSETS=1000
# Per HTTP request. 8 MiB default; use 1 MiB on slow uplinks (64 KiB–16 MiB).
UPLOAD_CHUNK_BYTES=8388608
# Optional override. Linux uses /usr/bin/ffmpeg (install the OS ffmpeg package);
# Windows/macOS use the bundled binary by default. The container installs ffmpeg.
# FFMPEG_PATH=/usr/bin/ffmpeg
# Optional paired FFprobe override for video input/output verification.
# FFPROBE_PATH=/usr/bin/ffprobe
# Set false after inviting the initial users if open signup is not wanted.
ALLOW_REGISTRATION=true
# Detailed raw viewing logs are retained indefinitely. false stops new collection.
ANALYTICS_ENABLED=true
# Bootstrap server administrator account UUIDs (not emails). Explicit role
# overrides made in the admin menu take precedence and persist in the database.
# Get your account ID from GET /api/v1/auth/me. No account is an admin by default.
SERVER_ADMIN_USER_IDS=
# Optional WinVAI01 privileged update helper. Never grant the web task admin
# rights or expose a Docker socket. Install separately after reviewing docs/admin.md.
# WINDOWS_MAINTENANCE_DIR=C:/ProgramData/Mirea/maintenance
# Android's remote API endpoint, applied when building/syncing the app.
# VITE_API_URL=https://mirea.example.com
# Optional PUBLIC Android update bundle (manifest.json + mirea-android-<code>.apk).
# Never put signing keys in this directory. Empty/unset disables update hosting.
# APP_UPDATES_DIR=C:/ProgramData/Mirea/app-updates
