<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted LAN HTTPS: only CAs explicitly installed/trusted by the device
     user are added. Certificate/hostname/expiry checks remain enabled. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
